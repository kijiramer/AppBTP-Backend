# Copier en .env (ignore par git) et remplir pour le developpement local.

# Secret de signature des JWT. Generer une valeur aleatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changer cette valeur invalide tous les tokens : chacun devra se reconnecter.
JWT_SECRET=

# Chaine de connexion MongoDB Atlas.
MONGODB_URI=

# Identifiants Cloudinary (dashboard Cloudinary > Account Details).
# Sans ces 3 valeurs, les routes d'upload de photo (/uploadRemarquePhoto,
# /uploadConstatationPhoto) renvoient 500.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
